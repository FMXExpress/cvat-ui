#
# Video prediction dispatch settings
#
# Allowed values: queued, parallel
CVAT_JOB_VIDEO_PREDICTION_DISPATCH_MODE=queued

# Parallel mode concurrency limits (must be positive integers)
CVAT_JOB_VIDEO_PREDICTION_MAX_CONCURRENCY_FAST=1
CVAT_JOB_VIDEO_PREDICTION_MAX_CONCURRENCY_SLOW=1

# Queue behavior
# Wait timeout in seconds before returning 503
CVAT_JOB_VIDEO_PREDICTION_DISPATCH_QUEUE_TIMEOUT_SECONDS=30
# Per-pathway queue length limits (0 disables queue size limit)
CVAT_JOB_VIDEO_PREDICTION_DISPATCH_MAX_QUEUE_LENGTH_FAST=0
CVAT_JOB_VIDEO_PREDICTION_DISPATCH_MAX_QUEUE_LENGTH_SLOW=0
